{
  "schema_version": 1,
  "name": "gmp",
  "phase": "temp-tools",
  "execution": "host-cross",
  "steps": [
    {
      "name": "configure",
      "argv": [
        "/work/src/configure",
        "--prefix=/usr",
        "--libdir=/usr/lib64",
        "--disable-static",
        "--enable-shared",
        "CC={cc}",
        "CFLAGS=-O2",
        "LDFLAGS={ldflags}"
      ]
    },
    {
      "name": "build",
      "argv": [
        "make",
        "-j{jobs}"
      ]
    },
    {
      "name": "stage-install",
      "argv": [
        "make",
        "install",
        "DESTDIR=/work/stage"
      ]
    }
  ],
  "native_steps": [
    {
      "name": "configure",
      "argv": [
        "/work/src/configure",
        "--prefix=/usr",
        "--libdir=/usr/lib64",
        "--disable-static",
        "--enable-shared",
        "CC=/usr/bin/gcc",
        "CFLAGS=-O2"
      ]
    },
    {
      "name": "build",
      "argv": [
        "make",
        "-j{jobs}"
      ]
    },
    {
      "name": "stage-install",
      "argv": [
        "make",
        "install",
        "DESTDIR=/work/stage"
      ]
    }
  ],
  "validation": {
    "chroot_executables": []
  }
}
