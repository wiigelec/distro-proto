        "NM_FOR_TARGET=/usr/bin/nm",
        "RANLIB_FOR_TARGET=/usr/bin/ranlib",
        "STRIP_FOR_TARGET=/usr/bin/strip",
        "CC_FOR_TARGET=/usr/bin/gcc -fno-link-libatomic",
        "CXX_FOR_TARGET=/usr/bin/gcc -nostdinc++ -fno-link-libatomic",
        "CFLAGS=-O2",
