  ],
  "validation": {
    "chroot_executables": [
      "/usr/bin/gcc",
      "/usr/bin/g++"
    ]
  },
  "environment": {
    "gcc_cv_sys_sdt_h": "no",
    "CFLAGS_FOR_TARGET": "-O2 -fno-link-libatomic",
    "CXXFLAGS_FOR_TARGET": "-O2 -fno-link-libatomic"
  }
}
