{
  "schema_version": 1,
  "name": "native-gcc",
  "phase": "temp-tools",
  "execution": "host-cross",
  "steps": [
    {
      "name": "configure",
      "argv": [
        "/work/src/configure",
        "--build=x86_64-pc-linux-gnu",
        "--host={target}",
        "--target={target}",
        "--prefix=/usr",
        "--with-build-sysroot=/toolchain",
        "--with-native-system-header-dir=/usr/include",
        "--with-gmp=/toolchain/usr",
        "--with-mpfr=/toolchain/usr",
        "--with-mpc=/toolchain/usr",
        "--without-isl",
        "--without-zstd",
        "--disable-bootstrap",
        "--disable-multilib",
        "--disable-fixincludes",
        "--disable-nls",
        "--disable-libsanitizer",
        "--disable-libssp",
        "--disable-libquadmath",
        "--disable-libgomp",
        "--disable-libatomic",
        "--enable-languages=c,c++",
        "CC={cc}",
        "CXX={cxx}",
        "CC_FOR_BUILD=/usr/bin/gcc",
        "CXX_FOR_BUILD=/usr/bin/g++",
        "CFLAGS=-O2",
        "CXXFLAGS=-O2",
        "LDFLAGS={ldflags}",
        "CC_FOR_TARGET=/toolchain/usr/bin/{target}-gcc --sysroot=/toolchain -fno-link-libatomic",
        "CXX_FOR_TARGET=/toolchain/usr/bin/{target}-gcc --sysroot=/toolchain -nostdinc++ -fno-link-libatomic",
        "LDFLAGS_FOR_TARGET=-L/work/build/{target}/libgcc",
        "target_configargs=gcc_cv_target_thread_file=posix"
      ]
    },
    {
      "name": "build",
      "argv": [
        "make",
        "-j{jobs}"
      ]
    },
    {
      "name": "stage-install",
      "argv": [
        "make",
        "install",
        "DESTDIR=/work/stage"
      ]
    }
  ],
  "native_steps": [
    {
      "name": "configure",
      "argv": [
        "/work/src/configure",
        "--build={target}",
        "--host={target}",
        "--target={target}",
        "--prefix=/usr",
        "--with-native-system-header-dir=/usr/include",
        "--with-gmp=/usr",
        "--with-mpfr=/usr",
        "--with-mpc=/usr",
        "--without-isl",
        "--without-zstd",
        "--disable-bootstrap",
        "--disable-multilib",
        "--disable-fixincludes",
        "--disable-nls",
        "--disable-libsanitizer",
        "--disable-libssp",
        "--disable-libquadmath",
        "--disable-libgomp",
        "--disable-libatomic",
        "--enable-languages=c,c++",
        "CC=/usr/bin/gcc",
        "CXX=/usr/bin/g++",
        "CC_FOR_BUILD=/usr/bin/gcc",
        "CXX_FOR_BUILD=/usr/bin/g++",
        "AR=/usr/bin/ar",
        "AS=/usr/bin/as",
        "LD=/usr/bin/ld",
        "NM=/usr/bin/nm",
        "RANLIB=/usr/bin/ranlib",
        "STRIP=/usr/bin/strip",
        "AR_FOR_TARGET=/usr/bin/ar",
        "AS_FOR_TARGET=/usr/bin/as",
